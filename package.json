{
  "name": "calyx-ai",
  "description": "Official Calyx AI web, Android, Windows, and Linux clients",
  "author": "Calyx",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name calyxai",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "desktop": "electron .",
    "desktop:windows": "electron-builder --win nsis portable --publish never",
    "desktop:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@supabase/supabase-js": "2.75.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1"
  },
  "build": {
    "appId": "ai.calyx.desktop",
    "productName": "Calyx",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage"], "category": "Utility" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "asar": true
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@eslint/js": "9.17.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "wrangler": "^4.149.0"
  }
}
